    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-vite": "^4.0.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
