{
  "name": "toeic-trainer",
  "version": "0.1.0",
  "private": true,
  "description": "TOEIC grammar and writing trainer for Thai learners",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
